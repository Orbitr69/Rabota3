#include <iostream>
#include <fstream>
#include <clocale>
#include "Student.h"
using namespace std;

// 1. Insertion sort
void insertionSort(STUDENT arr[], int n) {
    for (int i = 1; i < n; i++) {
        STUDENT key = arr[i];
        int j = i - 1;
        while (j >= 0 && arr[j].groupNumber > key.groupNumber) {
            arr[j + 1] = arr[j];
            j--;
        }
        arr[j + 1] = key;
    }
}

// 2. Selection sort
void selectionSort(STUDENT arr[], int n) {
    for (int i = 0; i < n - 1; i++) {
        int minIdx = i;
        for (int j = i + 1; j < n; j++) {
            if (arr[j].groupNumber < arr[minIdx].groupNumber)
                minIdx = j;
        }
        if (minIdx != i) {
            STUDENT temp = arr[i];
            arr[i] = arr[minIdx];
            arr[minIdx] = temp;
        }
    }
}

// 3. Bubble sort
void bubbleSort(STUDENT arr[], int n) {
    for (int i = 0; i < n - 1; i++) {
        bool swapped = false;
        for (int j = 0; j < n - i - 1; j++) {
            if (arr[j].groupNumber > arr[j + 1].groupNumber) {
                STUDENT temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
                swapped = true;
            }
        }
        if (!swapped) break;
    }
}

// 4. Gnome sort
void gnomeSort(STUDENT arr[], int n) {
    int i = 0;
    while (i < n) {
        if (i == 0 || arr[i - 1].groupNumber <= arr[i].groupNumber)
            i++;
        else {
            STUDENT temp = arr[i];
            arr[i] = arr[i - 1];
            arr[i - 1] = temp;
            i--;
        }
    }
}

// 5. Shell sort
void shellSort(STUDENT arr[], int n) {
    for (int gap = n / 2; gap > 0; gap /= 2) {
        for (int i = gap; i < n; i++) {
            STUDENT temp = arr[i];
            int j;
            for (j = i; j >= gap && arr[j - gap].groupNumber > temp.groupNumber; j -= gap) {
                arr[j] = arr[j - gap];
            }
            arr[j] = temp;
        }
    }
}

double averageGrade(const STUDENT& s) {
    double sum = 0;
    for (int i = 0; i < 5; i++) sum += s.grades[i];
    return sum / 5.0;
}

int main() {
    const int N = 10;
    STUDENT students[N];

    // 1. Чтение из текстового файла
    ifstream fin("students.txt");
    if (!fin) {
        cout << "Файл students.txt не найден!\n";
        return 1;
    }

    for (int i = 0; i < N && fin >> students[i]; i++);
    fin.close();

    // 2. Вывод исходного массива
    cout << "Исходные студенты:\n";
    for (int i = 0; i < N; i++) cout << students[i] << endl;
    cout << "\n=====================================\n\n";

    // 3. Копия для сортировок
    STUDENT temp[N];

    // 1. Insertion sort
    memcpy(temp, students, sizeof(students));
    insertionSort(temp, N);
    cout << "1. После Insertion Sort:\n";
    for (int i = 0; i < N; i++) cout << temp[i] << endl;
    cout << "\n";

    // 2. Selection sort
    memcpy(temp, students, sizeof(students));
    selectionSort(temp, N);
    cout << "2. После Selection Sort:\n";
    for (int i = 0; i < N; i++) cout << temp[i] << endl;
    cout << "\n";

    // 3. Bubble sort
    memcpy(temp, students, sizeof(students));
    bubbleSort(temp, N);
    cout << "3. После Bubble Sort:\n";
    for (int i = 0; i < N; i++) cout << temp[i] << endl;
    cout << "\n";

    // 4. Gnome sort
    memcpy(temp, students, sizeof(students));
    gnomeSort(temp, N);
    cout << "4. После Gnome Sort:\n";
    for (int i = 0; i < N; i++) cout << temp[i] << endl;
    cout << "\n";

    // 5. Shell sort
    memcpy(temp, students, sizeof(students));
    shellSort(temp, N);
    cout << "5. После Shell Sort:\n";
    for (int i = 0; i < N; i++) cout << temp[i] << endl;
    cout << "\n";

    // 4. Основная сортировка (например, insertion)
    STUDENT sorted[N];
    memcpy(sorted, students, sizeof(students));
    insertionSort(sorted, N);

    // 5. Запись в двоичный файл
    ofstream fout("students.bin", ios::binary);
    fout.write((char*)sorted, N * sizeof(STUDENT));
    fout.close();
    cout << "Отсортированные студенты записаны в students.bin\n\n";

    // 6. Чтение из двоичного файла
    ifstream finBin("students.bin", ios::binary);
    STUDENT binStudents[N];
    finBin.read((char*)binStudents, N * sizeof(STUDENT));
    int binCount = finBin.gcount() / sizeof(STUDENT);
    finBin.close();

    // 7. Вывод студентов со средним > 4.0
    cout << "Студенты со средним баллом > 4.0:\n";
    bool found = false;
    for (int i = 0; i < binCount; i++) {
        int sum = 0;
        for (int j = 0; j < 5; j++) sum += binStudents[i].grades[j];
        double avg = sum / 5.0;
        if (avg > 4.0) {
            cout << binStudents[i].fullName << ", группа " << binStudents[i].groupNumber << endl;
            found = true;
        }
    }
    if (!found) cout << "Таких студентов нет.\n";

    return 0;
}
